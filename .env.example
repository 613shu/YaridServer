# ───────────── The Great Fair — environment variables ─────────────
# Copy this file to ".env" and fill in your own values. Never commit .env!

# Database (Supabase → Connect → "Session pooler" connection string)
DATABASE_URL="postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# Used by migrations. With the Session pooler it is the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# A separate EMPTY database for automated tests (name must contain "test"). Tests delete all its data!
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yarid_test"

# Long random secret for signing login tokens (at least 16 characters)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=3000
# Your React site address(es), comma separated. "*" allows everyone (fine while developing).
CORS_ORIGIN="*"

# Demo users created by the seed (in production only if these are set)
ADMIN_EMAIL="admin@yarid.local"
ADMIN_PASSWORD="Admin1234!"
ADMIN_NAME="ראש הקהל"
DEMO_MERCHANT_EMAIL="merchant@yarid.local"
DEMO_MERCHANT_PASSWORD="Merchant1234!"
DEMO_MERCHANT_NAME="סוחר לדוגמה"

# Optional
# DB_SSL=true                 # force SSL on/off (default: on for cloud, off for localhost)
# SIMULATION_ENABLED=true     # run the fair in the background
# GAME_HOUR_MS=150000         # 1 game hour = 2.5 real minutes (lower it to test faster)
